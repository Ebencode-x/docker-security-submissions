FROM golang:1.16-alpine AS build-stage

WORKDIR /usr/src/app

COPY code/example-backend .

RUN CGO_ENABLED=0 go build -o server .

FROM scratch

WORKDIR /usr/src/app

ENV REQUEST_ORIGIN=http://localhost:5001

COPY --from=build-stage /usr/src/app/server ./server

USER 1000

EXPOSE 8080

CMD ["./server"]
